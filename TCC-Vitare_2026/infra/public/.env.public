NODE_ENV=production
PORT=3000

VITE_API_URL=/api/v1

POSTGRES_DB=vitare
POSTGRES_USER=vitare
POSTGRES_PASSWORD=change-me-in-production

DATABASE_URL=postgresql://vitare:change-me-in-production@db:5432/vitare?schema=public
DIRECT_URL=postgresql://vitare:change-me-in-production@db:5432/vitare?schema=public
POOLED_DATABASE_URL=postgresql://vitare:change-me-in-production@db:5432/vitare?schema=public

APP_URL=https://vitare.app.br
CORS_ORIGIN=https://vitare.app.br

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://vitare.app.br/api/v1/auth/google/callback

JWT_ACCESS_SECRET=change-me-in-production-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

STAFF_JWT_SECRET=change-me-in-production-min-32-chars
STAFF_JWT_EXPIRES_IN=8h

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_KEY_PREFIX=vitare:
REDIS_CONNECT_TIMEOUT=5000
REDIS_COMMAND_TIMEOUT=5000

RESEND_API_KEY=
MAIL_FROM=Vitare <onboarding@vitare.app.br>