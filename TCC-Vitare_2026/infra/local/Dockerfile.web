# syntax=docker/dockerfile:1.7

FROM node:22-bookworm-slim AS build
ARG VITE_API_URL=/api/v1
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV VITE_API_URL=$VITE_API_URL
WORKDIR /workspace

RUN corepack enable \
    && corepack prepare pnpm@9.15.9 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/web-staff/package.json apps/web-staff/package.json
RUN pnpm install --frozen-lockfile

COPY apps/web apps/web
COPY apps/web-staff apps/web-staff
RUN pnpm --filter @vitare/web build \
    && pnpm --filter @vitare/web-staff build

FROM nginx:1.29-alpine AS runtime
COPY infra/local/nginx.conf /etc/nginx/nginx.conf
COPY --from=build /workspace/apps/web/dist /usr/share/nginx/html
COPY --from=build /workspace/apps/web-staff/dist /usr/share/nginx/staff

EXPOSE 80 443