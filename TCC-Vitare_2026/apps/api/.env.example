# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vitare?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/vitare?schema=public"
POOLED_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vitare?schema=public"

# Server
NODE_ENV=development
PORT=3000

# Frontend URL
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# JWT
JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Staff JWT
STAFF_JWT_SECRET=your-super-secret-staff-jwt-key-min-32-chars
STAFF_JWT_EXPIRES_IN=8h

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_KEY_PREFIX=vitare:
REDIS_CONNECT_TIMEOUT=5000
REDIS_COMMAND_TIMEOUT=5000

# Email (Resend)
RESEND_API_KEY=
MAIL_FROM=Vitare <onboarding@resend.dev>